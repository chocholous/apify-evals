{
    "actorSpecification": 1,
    "fields": {},
    "views": {
        "results": {
            "title": "Eval Results",
            "transformation": {
                "fields": [
                    "overallVerdict",
                    "testPrompt",
                    "agentOutput"
                ]
            },
            "display": {
                "component": "table",
                "properties": {
                    "overallVerdict": { "label": "Verdict",      "format": "text" },
                    "testPrompt":     { "label": "Prompt",       "format": "text" },
                    "agentOutput":    { "label": "Agent Output", "format": "text" }
                }
            }
        },
        "verdicts": {
            "title": "Tests",
            "transformation": {
                "fields": ["testIndex", "verdicts"],
                "unwind": ["verdicts"],
                "omit": ["evalCritique", "evalGapSeverity"]
            },
            "display": {
                "component": "table",
                "properties": {
                    "testIndex":    { "label": "Test Index", "format": "number" },
                    "checkType":    { "label": "Check Type", "format": "text"   },
                    "checkValue":   { "label": "Check",      "format": "text"   },
                    "verdict":      { "label": "Verdict",    "format": "text"   },
                    "evidence":     { "label": "Evidence",   "format": "text"   }
                }
            }
        }
    }
}
