{
    "agent": "claude-code",
    "scenario": "---\nname: mcp-test\n---\n\n## Test\nList available MCP tools.\n\n## Checkpoint\nThe answer should mention available tools.\n",
    "maxTurns": 5,
    "maxBudgetUsd": 1.00,
    "initPreset": "mcp_native",
    "mcpConfigJson": {
        "mcpServers": {
            "apify": {
                "command": "npx",
                "args": ["-y", "apify-mcp-server"],
                "env": {
                    "APIFY_TOKEN": "${APIFY_TOKEN}"
                }
            }
        }
    },
    "envVariables": {
        "APIFY_TOKEN": "apify_api_..."
    }
}
