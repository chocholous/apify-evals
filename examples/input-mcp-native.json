{
    "agent": "claude-code",
    "scenario": "---\nname: mcp-test\n---\n\n## Test\nList available MCP tools.\n\n## Checkpoint\nThe answer should mention available tools.\n",
    "maxTurns": 5,
    "maxBudgetUsd": 1.00,
    "initPreset": "mcp_native",
    "mcpConfigJson": {
        "mcpServers": {
            "github": {
                "command": "npx",
                "args": ["-y", "@modelcontextprotocol/server-github"],
                "env": {
                    "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
                }
            }
        }
    },
    "envVariables": {
        "GITHUB_TOKEN": "ghp_..."
    }
}
